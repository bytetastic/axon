<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Axon</RootNamespace>
    <AssemblyName>Axon</AssemblyName>
    <StartupObject>Axon.Program</StartupObject>
    <ApplicationIcon>Assets\axon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.1</Version>
    <Product>Axon</Product>
    <Description>Axon – Claude Code als Desktop-App</Description>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <NoWarn>WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\axon.ico" />
  </ItemGroup>

</Project>
