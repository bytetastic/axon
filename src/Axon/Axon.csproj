<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Axon</RootNamespace>
    <AssemblyName>Axon</AssemblyName>
    <StartupObject>Axon.Program</StartupObject>
    <ApplicationIcon>Assets\axon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.0</Version>
    <Product>Axon</Product>
    <Description>Axon – Claude Code als Desktop-App</Description>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <NoWarn>WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\axon.ico" />
  </ItemGroup>

  <!-- Whisper.net bringt native DLLs für alle Windows-Plattformen mit; Axon gibt es nur für win-x64. -->
  <Target Name="DropForeignWhisperRuntimes" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-x86/')) Or $([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-arm64/'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
